# 5. RISK PROFILE VISUALIZATION (SCATTER PLOT)
# ========================================================
plt.figure(figsize=(8, 5))
plt.scatter(df['Story_Points'], df['Estimated_Hours'], color='blue', alpha=0.7, edgecolors='k', label='Tasks')
plt.axvline(x=limit, color='red', linestyle='--', label=f'Risk Limit ({limit:.2f} Pts)')
